.eyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.09em;
  text-transform:uppercase;color:var(--muted);margin:0 0 7px}

/* Datenschutzkasten — der wichtigste Text der Seite */
.privat{border:2px solid var(--ink);background:var(--surface);padding:15px 17px;margin-bottom:24px}
.privat p{margin:0;font-size:13.5px;line-height:1.55;color:var(--ink2)}
.privat p{max-width:80ch}
.privat p+p{margin-top:8px}
.privat b{color:var(--ink)}
.privat .zeile{display:flex;flex-wrap:wrap;gap:9px;margin-top:13px}
button.knopf{font:600 13px/1 var(--sans);color:var(--ink);background:var(--surface);
  border:1.5px solid var(--line2);padding:8px 12px;cursor:pointer}
button.knopf:hover{border-color:var(--ink);background:var(--sunk)}
button.knopf.warn:hover{border-color:var(--de);color:var(--de)}

/* Notenspiegel */
.spiegel{border:1px solid var(--line);background:var(--surface);margin-bottom:26px}
.spiegel .zeile{display:flex;align-items:center;gap:12px;padding:9px 15px;
  border-top:1px solid var(--line)}
.spiegel .zeile:first-of-type{border-top:0}
.spiegel .kopfz{padding:13px 15px 11px;border-bottom:1.5px solid var(--line2);background:var(--sunk)}
.spiegel .fchip{width:9px;height:22px;flex:none;background:var(--f)}
.spiegel .fn{font-weight:600;font-size:14px}
.spiegel .fl{font-size:12px;color:var(--muted)}
.spiegel .schnitt{margin-left:auto;text-align:right;white-space:nowrap}
.spiegel .schnitt b{font-family:var(--serif);font-size:22px;font-weight:600;
  font-variant-numeric:tabular-nums}
.spiegel .schnitt span{display:block;font-family:var(--mono);font-size:10.5px;color:var(--muted)}

/* Wochen */
.woche{border:1px solid var(--line);background:var(--surface);margin-bottom:14px}
.woche.vorbei{opacity:.72}
.woche > summary{list-style:none;cursor:pointer;padding:13px 16px;
  display:flex;align-items:baseline;gap:13px;flex-wrap:wrap}
.woche > summary::-webkit-details-marker{display:none}
.woche > summary:hover{background:var(--sunk)}
.wnr{font-family:var(--serif);font-size:26px;font-weight:600;line-height:1;
  font-variant-numeric:tabular-nums;min-width:34px}
.wtermin{font-family:var(--mono);font-size:12.5px;color:var(--ink2)}
.wtags{margin-left:auto;display:flex;gap:5px;flex-wrap:wrap;font-family:var(--mono);
  font-size:10.5px;font-weight:600}
.wtags span{border:1px solid var(--f,var(--line2));padding:1px 5px;
  background:color-mix(in oklab,var(--f,var(--line2)) var(--tint-a),var(--surface))}
.wkurz{flex-basis:100%;font-size:12.5px;color:var(--de);font-weight:500}
.woche[open] > summary{border-bottom:1px solid var(--line);background:var(--sunk)}
.jetzt{border-width:2px;border-color:var(--ink)}
.jetzt .wnr::after{content:" ▸";font-size:15px;vertical-align:2px}

.fblock{border-top:1px solid var(--line);padding:11px 16px 13px;border-left:4px solid var(--f)}
.fblock:first-of-type{border-top:0}
.fkopf{display:flex;align-items:baseline;gap:9px;margin-bottom:6px}
.fkopf .fn{font-weight:600;font-size:13.5px}
.fkopf .fl{font-family:var(--mono);font-size:11px;color:var(--muted);margin-left:auto}
.fblock .wsum{font-size:13px;color:var(--ink2);line-height:1.5;margin-top:5px}
.fblock .fstd{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--muted);
  border:1px solid var(--line2);border-radius:5px;padding:1px 6px}
/* Die Wo?- und Bis-wann-Zeile. EINE Regel fuer alle drei Orte — am Baustein,
   an der Leistung und an der Selbstlernstrecke —, damit dieselbe Angabe nicht
   an einer Stelle gross und an der anderen klein steht. Beschluss C. K. vom
   19.09.2026; vorher hatte die Zeile am Baustein gar keine Regel und erbte die
   Grundschrift. VORFASSUNG: sus.tpl.html.vor_wogroesse_19092026 */
.wo{margin:6px 0 0;padding:0;display:grid;grid-template-columns:max-content 1fr;
  gap:2px 10px;font-size:12px;line-height:1.45}
.wo dt{font-family:var(--mono);font-size:10.5px;color:var(--muted);
  text-transform:none;padding-top:1px}
.wo dd{margin:0;color:var(--ink2)}
.fblock > .wo{margin-top:6px}
.fblock ul{list-style:none;margin:0;padding:0}
.fblock li{font-size:13px;color:var(--ink2);line-height:1.45;padding-left:50px;
  text-indent:-50px;margin-bottom:4px}
.fblock li b{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--muted);
  display:inline-block;width:44px;text-indent:0;white-space:nowrap;
  font-variant-numeric:tabular-nums}

/* Ordnungsdienst · eigener Block, weil er zur ganzen Woche gehört und
   keinem Fach — deshalb --ink statt --f und ohne linken Fachbalken. */
.dienst{border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  background:var(--sunk);padding:10px 16px 11px}
.dienst .dkopf{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.dienst .deyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;
