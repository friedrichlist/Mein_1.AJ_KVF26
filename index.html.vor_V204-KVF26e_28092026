    let t = ohnePhase(x.was);
    const m = /^(LS \d+\.\d+)\s*·\s*/.exec(t);
    if(m){ if(!kenn) kenn = m[1]; if(m[1] === kenn) t = t.slice(m[0].length); }
    t = mitFach(t, fach);
    /* Und dasselbe eine Ebene tiefer: Zwei Bloecke desselben Bausteins nennen
       ihn einmal. „SK_B02 · Vertiefung · SK_B02 · Berechnungswerkstatt" sieht
       nach zwei Bausteinen aus und ist einer. Ein Wechsel — B04 auf B05 —
       bleibt stehen, denn dort ist es wirklich ein zweiter. */
    const c = /^([A-Z0-9]+_B\d{2}[a-z]?)\s*·\s*/.exec(t);
    if(c){ if(c[1] === letzt) t = t.slice(c[0].length); else letzt = c[1]; }
    return t;
  }).filter(Boolean);
  const vorn = kenn ? kenn + ' · ' : '';
  let text = voll.join(' · ');
  if((vorn + text).length <= GRENZE) return vorn + text;
  const kurz = voll.map(t => { const i = t.indexOf(':'); return i > 12 ? t.slice(0, i) : t; });
  text = kurz.join(' · ');
  if((vorn + text).length <= GRENZE) return vorn + text;
  let aus = '';
  for(const t of kurz){ if((aus + ' · ' + t).length > GRENZE) break; aus = aus ? aus + ' · ' + t : t; }
  return vorn + aus + ' …';
}

/* Wo liegt das Skript zu den Bausteinen dieser Woche? Aus den Kennungen der
   Woche gebaut — aber nur fuer Bausteine, deren Skript wirklich im Ordner
   liegt (DATEN.skripte, am Bestand erhoben). Ein Baustein ohne gebautes
   Skript bekommt „Dateiname folgt"; wer nach einer Datei sucht, die es nicht
   gibt, sucht umsonst. Lernfeld 4 fuehrt in den Zelltexten noch die U- und
   W-Kennungen; dort steht deshalb vorerst nichts. */
function bausteinWo(fach, liste){
  const t = TEAMS[fach];
  const codes = [];
  liste.forEach(x => {
    const m = String(x.was || '').match(/(^|·\s)B(\d{2})(?![\w])/g) || [];
    m.forEach(k => { const c = 'B' + k.match(/\d{2}/)[0]; if(!codes.includes(c)) codes.push(c); });
  });
  if(!codes.length) return '';
  if(!t) return '<dl class="wo"><dt>Wo?</dt><dd>Teams · Kanal noch offen</dd></dl>';
  const da = ((DATEN.skripte || {})[SPALTE[fach]] || []);
  const namen = codes.filter(c => da.includes(c))
                     .map(c => 'KVF_' + SPALTE[fach] + '_' + c + '_Skript_SuS.docx');
  const wo = 'Teams · Kanal ' + t[0] + ' · Ordner ' + t[1] + ' · '
           + (namen.length ? namen.join(' · ') : 'Dateiname folgt');
  return '<dl class="wo"><dt>Wo?</dt><dd>' + esc(wo) + '</dd></dl>';
}

function woZeile(fach, datei, fundstelle){
  /* Neu mit Variante 110: bei Forms-Probefassungen (PUB, PKA) und den Quiz-
     sockel-Strecken nennt die Wo?-Zeile die Fundstelle im Skript (Seite,
     Kasten, QR-Code) statt Teams-Kanal/Ordner/Dateiname — die Klasse
     erreicht das Forms-Quiz ueber das Skript, nicht ueber eine abgelegte
     Datei. Nur gesetzt, wo die Fundstelle schon feststeht (Vormerkung vom
     22.09.2026); sonst faellt die Zeile auf die alte Logik zurueck. */
  if(fundstelle) return fundstelle;
  const t = TEAMS[fach];
  if(!t) return 'Teams · Kanal noch offen';
  /* Ein Forms-Quiz liegt in keinem Ordner: Die Klasse ruft es ueber den Link
     oder den QR-Code auf. Der Dateiname der Importdatei ist die Sache der
     Lehrkraft und hat hier nichts verloren. */
  if(/Forms/i.test(datei)){
    const code = String(datei).replace(/^Forms\s+/i, '').replace(/_?Forms\.docx$/i, '');
    return 'Teams · Kanal ' + t[0] + ' · Forms-Quiz ' + code;
  }
  return 'Teams · Kanal ' + t[0] + ' · Ordner ' + t[1] + (datei ? ' · ' + datei : ' · Dateiname folgt');
}

/* „Bis wann" ist die Woche, in der es fertig sein muss — nicht der Tag der
   Ausgabe. Sie steht im Pruefsatz des Plans; das Datum daneben ist der erste
   Tag dieser Blockwoche. */
function bisWann(x){
  const bw = /Blockwoche (\d+)(?:[^.]*? am ([\d.]+))?/.exec(x.pruefung || '');
  if(bw) return 'Blockwoche ' + bw[1] + (bw[2] ? ' · ' + bw[2] : '');
  const d = /bis (\d{1,2}\.\d{1,2}\.\d{4})/.exec(x.zeitraum || '');
  return d ? d[1] : '';
}

/* Der Zweck, und nur er. „zu Hause" steht schon im Abzeichen, „unbenotet" und
   „keine Unterrichtszeit" sagten dasselbe ein zweites und drittes Mal. */
function zweck(x){
  const m = /bewertet in ([^,·]+?) der Woche (\d+)/.exec(x.pruefung || '');
  if(!m) return '';
  return 'Grundlage für ' + m[1].trim().replace(/^(der|die|das)\s+/i, '') + ' in Woche ' + m[2];
}

/* ---------- Notenspiegel ---------- */
function spiegel(){
  const el = document.getElementById("spiegel");
  const benotet = DATEN.leistungen.filter(l => l.benotet);
  const gesamt = [];
  let html = '<div class="kopfz"><p class="eyebrow" style="margin:0">Mein Notenspiegel</p></div>';
  DATEN.faecher.forEach(f=>{
    const ls = benotet.filter(l => l.fach === f.id);
    const noten = ls.map(l => meine[l.lid]).filter(Boolean).map(n => WERT[n]).filter(n=>n);
    noten.forEach(n => gesamt.push(n));
    const schnitt = noten.length ? (noten.reduce((a,b)=>a+b,0)/noten.length) : null;
    html += '<div class="zeile" style="--f:var(--'+f.id+')">'
      + '<span class="fchip"></span>'
      + '<span><span class="fn">'+esc(f.name)+'</span><br>'
        + '<span class="fl">'+esc(f.lk)+'</span></span>'
      + '<span class="schnitt"><b>'+(schnitt ? schnitt.toFixed(1).replace(".",",") : "–")+'</b>'
        + '<span>'+noten.length+' von '+ls.length+'</span></span>'
      + '</div>';
  });
  const g = gesamt.length ? (gesamt.reduce((a,b)=>a+b,0)/gesamt.length) : null;
  html += '<div class="zeile" style="--f:var(--ink);border-top:1.5px solid var(--line2)">'
    + '<span class="fchip" style="background:var(--ink)"></span>'
    + '<span class="fn">Alle Fächer</span>'
    + '<span class="schnitt"><b>'+(g ? g.toFixed(1).replace(".",",") : "–")+'</b>'
      + '<span>'+gesamt.length+' von '+benotet.length+'</span></span></div>';
  el.innerHTML = html;
}

/* ---------- Wochen ---------- */
function wochen(){
  const ziel = document.getElementById("wochen");
  ziel.innerHTML = DATEN.wochen.map(w=>{
    const vorbei = !!ZEIT[w.nr].bis && ZEIT[w.nr].bis < heute;
    const ist = laufend && laufend.nr === w.nr;
    const auf = ist || (!laufend && naechste.nr === w.nr);
    const wl = DATEN.leistungen.filter(l => l.woche === w.nr);
    const dienstG = ordnungsdienst(w.nr);
    const dienstTag = dienstG ? '<span style="--f:var(--ink)">Dienst '+esc(dienstG.name)+'</span>' : "";
    const tags = dienstTag + DATEN.faecher.map(f=>{
      const b = wl.filter(l => l.fach===f.id && l.benotet);
      return b.length
        ? '<span style="--f:var(--'+f.id+')">'+b.map(x=>esc(x.art)).join(" ")+' '+esc(f.name.replace("Lernfeld","LF"))+'</span>'
        : "";
    }).join("");

    const koerper = DATEN.faecher.map(f=>{
      const st = (DATEN.stoff[f.id]||{})[w.nr] || [];
      const ls = wl.filter(l => l.fach === f.id);
      const sr = (DATEN.strecken||[]).filter(x => x.fach===f.id && x.woche===w.nr);
      if(!st.length && !ls.length && !sr.length) return "";
      const std = st.reduce((a,x)=>a+(+x.std||0),0);
      return '<div class="fblock" style="--f:var(--'+f.id+')">'
        + '<div class="fkopf"><span class="fn">'+esc(f.name)+'</span>'
          + (std ? '<span class="fstd">'+String(std).replace(".",",")+' Std</span>' : '')
          + '<span class="fl">'+esc(f.lk)+'</span></div>'
        + (st.length ? '<div class="wsum">'+esc(themen(st, f.id))+'</div>'
                       + bausteinWo(f.id, st) : '')
        + ls.map(l=>leistungHtml(l)).join("")
        + sr.map(x=>streckeHtml(x)).join("")
        + '</div>';
    }).join("");

    return '<details class="woche'+(vorbei?" vorbei":"")+(ist?" jetzt":"")+'"'+(auf?" open":"")+'>'
      + '<summary><span class="wnr">'+w.nr+'</span>'
        + '<span class="wtermin">'+esc(w.termin)+'</span>'
        + (tags ? '<span class="wtags">'+tags+'</span>' : '')
        + (w.kurz ? '<span class="wkurz">'+esc(w.kurz)+'</span>' : '')
      + '</summary>' + dienstHtml(w.nr) + koerper + '</details>';
  }).join("");

  ziel.querySelectorAll("select[data-lid]").forEach(s=>{
    s.addEventListener("change", e=>{
      const lid = e.target.dataset.lid;
      if(e.target.value) meine[lid] = e.target.value; else delete meine[lid];
      schreiben();
      e.target.classList.toggle("gesetzt", !!e.target.value);
      spiegel();
    });
  });
}

/* Selbstlernstrecken · Regel 12, Variante 60.
   Was zu Hause zu tun ist, gehoert in diese Fassung und nicht nur in den
   Lehrerplan: wann das Blatt kommt, bis wann es zu bearbeiten ist und woran
   es geprueft wird. */
function streckeHtml(x){
  const zeile = (t, w) => w ? '<dt>'+t+'</dt><dd>'+esc(w)+'</dd>' : '';
  return '<div class="strecke">'
    + '<div class="sk"><span class="sart">zu Hause bearbeiten</span>'
      + (x.blatt ? '<span class="sblatt">'+esc(x.strecke ? x.strecke+' '+x.blatt : x.blatt)+'</span>' : '')
      + (x.minuten ? '<span class="smin">rund '+x.minuten+' Min.</span>' : '')
    + '</div>'
    + (zweck(x) ? '<div class="st">'+esc(zweck(x))+'</div>' : '')
    + '<dl class="wo">' + zeile('Bis wann', bisWann(x))
            + zeile('Wo?', woZeile(x.fach, x.datei, x.fundstelle)) + '</dl>'
    + '</div>';
}

/* Der Kopf einer Leistung. „PUB 1" statt „T 1", „PKA 1" statt „T KA 1" —
   dieselbe Rolle, die der Dateiname traegt (Variante 85). Das alte Zeichen „T"
   wird weiter gelesen, damit eine Tafel aus einem aelteren Stand nicht
   plötzlich „T" zeigt, wo der Plan „PUB" sagt. */
function leistungKopf(l){
  const nr = String(l.nr == null ? '' : l.nr).trim();
  if(l.art === 'PUB' || l.art === 'T')
    return /^KA/.test(nr) ? ('PKA ' + nr.slice(2).trim()).trim() : ('PUB ' + nr).trim();
  return (l.art + (nr ? ' ' + nr : '')).trim();
}

function leistungHtml(l){
  const gesetzt = meine[l.lid] || "";
  return '<div class="leist">'
    + '<div class="lk"><span class="lart">'+esc(leistungKopf(l))+'</span>'
      + (l.form ? '<span class="lform">'+esc(l.form)+'</span>' : '')
      + (l.benotet
          ? '<span class="note"><label for="n_'+esc(l.lid)+'">meine Note</label>'
            + '<select id="n_'+esc(l.lid)+'" data-lid="'+esc(l.lid)+'"'
            + (gesetzt?' class="gesetzt"':'')+'>'
            + '<option value="">–</option>'
            + NOTEN.map(n=>'<option'+(n===gesetzt?" selected":"")+'>'+n+'</option>').join("")
            + '</select></span>'
          : '<span class="uebung">nicht bewertet</span>')
    + '</div>'
    + (l.titel ? '<div class="lt">'+esc(ohnePhase(l.titel))+'</div>' : '')
    /* Eine bewertete Leistung bekommt KEINE Wo?-Zeile: Sie wird im Unterricht
       ausgeteilt und geschrieben, nicht zu Hause geholt. Ein Ordnerhinweis
       daran hat nur so ausgesehen, als koenne man sich vorher bedienen.
       Beschluss C. K. vom 19.09.2026. */
    + (l.benotet ? '' : '<dl class="wo"><dt>Wo?</dt><dd>'+esc(woZeile(l.fach, l.datei, l.fundstelle))+'</dd></dl>')
    + '</div>';
}

/* ---------- Sichern, einlesen, leeren ---------- */
const dlg = document.getElementById("dlg");
const feld = document.getElementById("dlg-feld");
const dTitel = document.getElementById("dlg-titel");
const dText = document.getElementById("dlg-text");
const dOk = document.getElementById("dlg-ok");
const dDatei = document.getElementById("dlg-datei");
let modus = "sichern";

document.getElementById("b-sichern").addEventListener("click", ()=>{
  modus = "sichern";
  dTitel.textContent = "Deine Eintragungen sichern";
  dText.textContent = "Kopiere diesen Text und bewahre ihn auf, oder speichere ihn als Datei. "
    + "Damit kannst du deine Noten später oder auf einem anderen Gerät wieder einlesen.";
  feld.value = JSON.stringify({stand:new Date().toISOString().slice(0,10), noten:meine}, null, 1);
  feld.readOnly = false;
  dOk.hidden = true; dDatei.hidden = false;
  dlg.showModal(); feld.select();
});

document.getElementById("b-laden").addEventListener("click", ()=>{
  modus = "laden";
  dTitel.textContent = "Sicherung einlesen";
  dText.textContent = "Füge hier den gesicherten Text ein. Deine jetzigen Eintragungen "
    + "werden dabei ersetzt.";
  feld.value = ""; feld.readOnly = false;
  dOk.hidden = false; dDatei.hidden = true;
  dlg.showModal(); feld.focus();
});

dOk.addEventListener("click", ()=>{
  if(modus !== "laden") return dlg.close();
  try {
    const x = JSON.parse(feld.value);
    const n = (x && x.noten) ? x.noten : x;
    if(!n || typeof n !== "object") throw new Error();
    meine = {};
    /* Auch eine aeltere Sicherung mit Tendenzen laesst sich einlesen. */
    Object.keys(n).forEach(k => { const g = ganzeNote(n[k]); if(g) meine[k] = g; });
    schreiben(); spiegel(); wochen(); dlg.close();
  } catch(e){
    dText.textContent = "Das war keine gültige Sicherung. Füge den ganzen Text ein, "
      + "so wie er beim Sichern angezeigt wurde — von der ersten geschweiften Klammer bis zur letzten.";
  }
});

dDatei.addEventListener("click", ()=>{
  const blob = new Blob([feld.value], {type:"application/json"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "meine-noten-kvf26.json";
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href), 4000);
});

document.getElementById("dlg-zu").addEventListener("click", ()=>dlg.close());
document.getElementById("b-druck").addEventListener("click", ()=>{
  document.querySelectorAll("details.woche").forEach(d=>d.open = true);
  window.print();
});
document.getElementById("b-leeren").addEventListener("click", ()=>{
  if(!Object.keys(meine).length) return;
  if(!confirm("Alle eingetragenen Noten auf diesem Gerät löschen? Das lässt sich nicht rückgängig machen.")) return;
  meine = {}; schreiben(); spiegel(); wochen();
});

spiegel();
wochen();
</script>

