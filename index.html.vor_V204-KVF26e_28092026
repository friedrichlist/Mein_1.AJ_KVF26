.dienst .dn{font-weight:600;font-size:13.5px}
.dienst .dfirmen{font-family:var(--mono);font-size:11px;color:var(--muted)}
.dienst ul{list-style:none;margin:0;padding:0}
.dienst li{font-size:12.5px;color:var(--ink2);line-height:1.5;padding-left:13px;
  position:relative}
.dienst li::before{content:"–";position:absolute;left:0;color:var(--muted)}

.leist{margin-top:10px;border:1.5px solid var(--f);border-radius:0 10px 10px 0;
