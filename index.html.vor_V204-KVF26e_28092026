/* Zeitraum einer Blockwoche. Bevorzugt werden `von` und `bis`; stehen sie
   leer, wird er aus `termin` gewonnen — „31.08.–04.09.2026" ebenso wie
   „21.–25.09.2026".
   Warum: `von` und `bis` sind in sus_daten.json seit jeher leer, inventar.js
   fuellt sie nicht. Die Seite rechnete damit ueber tag("") mit einem
   ungültigen Datum, und jeder Vergleich damit ist falsch. Folge: `laufend`
   war nie gesetzt, `naechste` fiel immer auf wochen[13] zurueck — die App
   klappte am 22.09.2026, mitten in Blockwoche 2, die Woche 14 auf und
   markierte keine Woche als laufend oder vorbei. Im Browser nachgestellt.
   VORFASSUNG: sus.tpl.html.vor_wochenfehler_22092026 */
function zeitraum(w){
  if (w.von && w.bis)
    return {von:new Date(w.von+"T00:00:00"), bis:new Date(w.bis+"T23:59:59")};
  const teil = String(w.termin || "").split(/[–—]/);
  const r = /(\d{1,2})\.(\d{1,2})\.(\d{4})/.exec(teil[1] || "");
  if(!r) return {};
  const jahr = +r[3], bisM = +r[2], bisT = +r[1];
  const l = /(\d{1,2})\.(?:(\d{1,2})\.)?/.exec(teil[0] || "");
  if(!l) return {};
  const vonT = +l[1], vonM = l[2] ? +l[2] : bisM;
  return {von:new Date(vonM > bisM ? jahr-1 : jahr, vonM-1, vonT),
          bis:new Date(jahr, bisM-1, bisT, 23, 59, 59)};
}
