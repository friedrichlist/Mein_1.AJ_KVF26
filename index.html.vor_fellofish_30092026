   wird auf ihre ganze Note gelegt — 2+ und 2- sind eine Zwei. Ohne diese
   Zeile stuende sie nach dem Umstieg auf "-" und waere still weg. */
function ganzeNote(n){ const m = /^([1-6])[+-]?$/.exec(String(n == null ? "" : n)); return m ? m[1] : null; }
function lesen(){
  try { meine = JSON.parse(localStorage.getItem(SPEICHER) || "{}") || {}; }
  catch(e){ meine = {}; }
  let geaendert = false;
  Object.keys(meine).forEach(k => {
    const g = ganzeNote(meine[k]);
    if(g === null){ delete meine[k]; geaendert = true; }
    else if(g !== meine[k]){ meine[k] = g; geaendert = true; }
  });
  if(geaendert) schreiben();
}
function schreiben(){
  try { localStorage.setItem(SPEICHER, JSON.stringify(meine)); } catch(e){}
}
